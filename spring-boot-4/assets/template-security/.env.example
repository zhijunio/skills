# Set these values for your local identity provider and local demo account.
OIDC_CLIENT_ID=replace-with-client-id
OIDC_CLIENT_SECRET=replace-with-client-secret
OIDC_AUTHORIZATION_URI=https://identity.example.test/oauth2/authorize
OIDC_TOKEN_URI=https://identity.example.test/oauth2/token
OIDC_USER_INFO_URI=https://identity.example.test/userinfo
OIDC_USERNAME_ATTRIBUTE=sub
OIDC_JWK_SET_URI=https://identity.example.test/jwks
PARTNER_CLIENT_ID=replace-with-client-id
PARTNER_CLIENT_SECRET=replace-with-client-secret
PARTNER_TOKEN_URI=https://partner-identity.example.test/oauth2/token
PARTNER_API_BASE_URL=https://inventory.example.test
RESOURCE_SERVER_ISSUER_URI=https://identity.example.test
RESOURCE_SERVER_JWK_SET_URI=https://identity.example.test/jwks
RESOURCE_SERVER_AUDIENCE=template-security
DEMO_USERNAME=demo@example.test
DEMO_PASSWORD=replace-with-a-local-password
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@example.test

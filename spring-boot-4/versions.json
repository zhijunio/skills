{
  "schemaVersion": 1,
  "checkedOn": "2026-11-24",
  "springBoot": {
    "default": "4.2.0",
    "maven": "4.2.0",
    "supportedLines": ["4.2.x", "4.1.x", "4.0.x"]
  },
  "java": {
    "default": "21",
    "minimum": "17",
    "maximumBySpringBootMajor": {
      "4": "27"
    }
  },
  "mavenMinimum": "3.6.3",
  "postgresql": {
    "defaultMajor": "18",
    "image": "postgres:18-alpine"
  },
  "redis": {
    "image": "redis:8-alpine"
  },
  "mailpit": {
    "image": "axllent/mailpit:v1.34.0"
  },
  "mybatisPlus": {
    "default": "3.5.18",
    "source": "https://baomidou.com/en/getting-started/install/"
  },
  "architectureTesting": {
    "taikai": {
      "default": "1.67.0",
      "source": "https://enofex.github.io/taikai/documentation/"
    }
  },
  "jackson": {
    "major": 3,
    "mapper": "tools.jackson.databind.json.JsonMapper",
    "source": "https://docs.spring.io/spring-boot/reference/features/json.html"
  },
  "springdoc": {
    "artifact": "springdoc-openapi-starter-webmvc-ui",
    "bySpringBootLine": {
      "4.2.x": { "recommended": "3.2.1", "compatible": "3.2.1" },
      "4.1.x": { "recommended": "3.2.1", "compatible": "3.1.x - 3.2.x" },
      "4.0.x": { "recommended": "3.0.3", "compatible": "3.0.x" }
    },
    "source": "https://springdoc.org/"
  },
  "therapiRuntimeJavadoc": {
    "default": "0.16.0",
    "source": "https://springdoc.org/"
  },
  "bootui": {
    "default": "2.0.0",
    "source": "https://www.julien-dubois.com/boot-ui/setup"
  },
  "spotless": {
    "mavenPlugin": "3.12.0",
    "gradlePlugin": "8.12.0",
    "palantirJavaFormat": "2.103.0",
    "source": "https://github.com/diffplug/spotless/releases/tag/maven/3.12.0",
    "gradleSource": "https://plugins.gradle.org/plugin/com.diffplug.spotless"
  },
  "mavenRelease": {
    "plugin": "3.3.1",
    "source": "https://maven.apache.org/maven-release/maven-release-plugin/"
  },
  "jacoco": {
    "mavenPlugin": "0.8.16",
    "source": "https://www.jacoco.org/jacoco/trunk/doc/maven.html"
  },
  "sources": {
    "springBootSystemRequirements": "https://docs.spring.io/spring-boot/system-requirements.html",
    "springInitializr": "https://start.spring.io"
  }
}

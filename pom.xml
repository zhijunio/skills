<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.zhijun-io</groupId>
        <artifactId>rose-parent</artifactId>
        <version>0.0.3</version>
        <relativePath/>
    </parent>

    <groupId>io.github.zhijunio</groupId>
    <artifactId>agent-skills</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Agent Skills</name>
    <description>Reusable agent skills for frontend, Java, Spring Boot, Spring Cloud, and PostgreSQL development</description>
    <url>https://github.com/zhijunio/skills</url>

    <scm>
        <url>https://github.com/zhijunio/skills</url>
        <connection>scm:git:https://github.com/zhijunio/skills.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/zhijunio/skills.git</developerConnection>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <skillsjars.version>0.0.7</skillsjars.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>com.skillsjars</groupId>
                <artifactId>maven-plugin</artifactId>
                <version>${skillsjars.version}</version>
                <configuration>
                    <skillsDir>${project.basedir}</skillsDir>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>package</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

# Copy to .env and fill in real values. .env is gitignored — never commit it.
#
# The generated application imports this file through
# `spring.config.import: optional:file:.env[.properties]`. Docker Compose also
# reads `.env` for interpolation. Add a variable here only when the generated
# application, Compose file, or another committed tool consumes it.

# Local port (override per Git worktree when needed)
SERVER_PORT=8080

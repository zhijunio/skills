# Copy to .env. Generate matching RSA key files under .local/keys first; never commit private keys.
PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/jwt_demo
DATABASE_USERNAME=jwt_demo
DATABASE_PASSWORD=jwt_demo_local
JWT_PUBLIC_KEY=file:.local/keys/public.pem
JWT_PRIVATE_KEY=file:.local/keys/private.pem
JWT_KEY_ID=local-rsa-key
JWT_ISSUER=sb4-jwt-api
JWT_AUDIENCE=sb4-jwt-client
JWT_ACCESS_TOKEN_TTL=15m

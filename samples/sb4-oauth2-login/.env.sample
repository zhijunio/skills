# Generate with: openssl rand -base64 32
# Replace with the exact output of: openssl rand -base64 32
JWT_SECRET=replace-with-base64-32-byte-secret
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=sb4-oauth2-login-api
DEMO_PASSWORD=replace-with-a-local-demo-password
ADMIN_PASSWORD=replace-with-a-local-admin-password
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/oauth2_demo
SPRING_DATASOURCE_USERNAME=oauth2_demo
SPRING_DATASOURCE_PASSWORD=oauth2_demo
# Replace with a separate exact output of: openssl rand -base64 32
OAUTH2_CLIENT_SECRET_ENCRYPTION_KEY=replace-with-base64-32-byte-key
OAUTH2_ALLOWED_HOSTS=localhost,127.0.0.1,github.com,api.github.com,accounts.google.com,oauth2.googleapis.com,openidconnect.googleapis.com,www.googleapis.com,www.facebook.com,graph.facebook.com,appleid.apple.com

# OAuth2 clients are now added and edited in the administrator page.
# Use openssl rand -base64 32 to generate both key values above.

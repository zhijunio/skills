diff -ruN -x target -x *.log -x *.tar.gz -x cp.txt base/src/test/java/com/example/portal/PortalDocumentTests.java disabled/src/test/java/com/example/portal/PortalDocumentTests.java
--- base/src/test/java/com/example/portal/PortalDocumentTests.java	1970-01-01 08:00:00
+++ disabled/src/test/java/com/example/portal/PortalDocumentTests.java	2026-11-24 11:02:13
@@ -0,0 +1,228 @@
+package com.example.portal;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.patch;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc;
+import org.springframework.http.MediaType;
+import org.springframework.mock.web.MockHttpSession;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.MvcResult;
+import org.springframework.test.web.servlet.ResultActions;
+
+import com.jayway.jsonpath.JsonPath;
+
+@SpringBootTest
+@AutoConfigureMockMvc
+class PortalDocumentTests {
+
+	private static final String PASSWORD = "demo-password";
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	private Editor alice;
+
+	private Editor bob;
+
+	@BeforeEach
+	void resetDocuments() throws Exception {
+		alice = login("alice");
+		bob = login("bob");
+		alice.update(1, "{\"title\":\"Alice draft\",\"note\":null}").andExpect(status().isOk());
+		bob.update(2, "{\"title\":\"Bob draft\",\"note\":null}").andExpect(status().isOk());
+		alice.patchPreference("{\"theme\":\"light\"}").andExpect(status().isOk());
+		bob.patchPreference("{\"theme\":\"light\"}").andExpect(status().isOk());
+	}
+
+	@Test
+	void titleOnlyUpdateMatchesExistingJsonWhenDocumentHasNoNote() throws Exception {
+		alice.update(1, "{\"title\":\"Renamed\"}")
+				.andExpect(status().isOk())
+				.andExpect(content().json("{\"title\":\"Renamed\"}", true));
+		alice.read(1).andExpect(status().isOk()).andExpect(content().json("{\"title\":\"Renamed\"}", true));
+	}
+
+	@Test
+	void omittedNoteKeepsSavedNoteAndTitleOnlyResponseStaysWithoutNote() throws Exception {
+		alice.update(1, "{\"title\":\"Alice draft\",\"note\":\"remember\"}").andExpect(status().isOk());
+
+		alice.update(1, "{\"title\":\"Renamed\"}")
+				.andExpect(status().isOk())
+				.andExpect(content().json("{\"title\":\"Renamed\"}", true));
+		alice.read(1).andExpect(status().isOk()).andExpect(content().json("{\"title\":\"Renamed\",\"note\":\"remember\"}", true));
+	}
+
+	@Test
+	void jsonNullNoteClearsSavedNote() throws Exception {
+		alice.update(1, "{\"title\":\"Alice draft\",\"note\":\"remember\"}").andExpect(status().isOk());
+
+		alice.update(1, "{\"title\":\"Cleared\",\"note\":null}")
+				.andExpect(status().isOk())
+				.andExpect(content().json("{\"title\":\"Cleared\"}", true));
+		alice.read(1).andExpect(status().isOk()).andExpect(content().json("{\"title\":\"Cleared\"}", true));
+	}
+
+	@Test
+	void emptyStringNoteIsStoredAndReturned() throws Exception {
+		alice.update(1, "{\"title\":\"Named\",\"note\":\"\"}")
+				.andExpect(status().isOk())
+				.andExpect(content().json("{\"title\":\"Named\",\"note\":\"\"}", true));
+		alice.read(1).andExpect(status().isOk()).andExpect(content().json("{\"title\":\"Named\",\"note\":\"\"}", true));
+	}
+
+	@Test
+	void noteOfFortyCharactersIsStored() throws Exception {
+		String note = "a".repeat(40);
+		alice.update(1, "{\"title\":\"Bounded\",\"note\":\"" + note + "\"}")
+				.andExpect(status().isOk())
+				.andExpect(content().json("{\"title\":\"Bounded\",\"note\":\"" + note + "\"}", true));
+		alice.read(1).andExpect(status().isOk()).andExpect(content().json("{\"title\":\"Bounded\",\"note\":\"" + note + "\"}", true));
+	}
+
+	@Test
+	void noteOfFortyOneCharactersIsRejectedAndDocumentStaysUnchanged() throws Exception {
+		alice.update(1, "{\"title\":\"Stable\",\"note\":\"kept\"}").andExpect(status().isOk());
+
+		MvcResult rejected = alice.update(1, "{\"title\":\"Changed\",\"note\":\"" + "b".repeat(41) + "\"}")
+				.andExpect(status().isBadRequest())
+				.andReturn();
+		alice.read(1).andExpect(status().isOk()).andExpect(content().json("{\"title\":\"Stable\",\"note\":\"kept\"}", true));
+		assertSameErrorShape(rejected, alice.read(99).andExpect(status().isNotFound()).andReturn());
+	}
+
+	@Test
+	void tooLongNoteKeepsEmptyNoteAndPreviousTitle() throws Exception {
+		alice.update(1, "{\"title\":\"Stable\",\"note\":\"\"}").andExpect(status().isOk());
+
+		alice.update(1, "{\"title\":\"Changed\",\"note\":\"" + "c".repeat(41) + "\"}")
+				.andExpect(status().isBadRequest());
+		alice.read(1).andExpect(status().isOk()).andExpect(content().json("{\"title\":\"Stable\",\"note\":\"\"}", true));
+	}
+
+	@Test
+	void missingTitleIsRejectedAndDocumentStaysUnchanged() throws Exception {
+		alice.update(1, "{\"title\":\"Stable\",\"note\":\"kept\"}").andExpect(status().isOk());
+
+		MvcResult rejected = alice.update(1, "{\"note\":\"other\"}")
+				.andExpect(status().isBadRequest())
+				.andReturn();
+		alice.read(1).andExpect(status().isOk()).andExpect(content().json("{\"title\":\"Stable\",\"note\":\"kept\"}", true));
+		assertSameErrorShape(rejected, bob.read(99).andExpect(status().isNotFound()).andReturn());
+	}
+
+	@Test
+	void nullTitleIsRejectedAndDocumentStaysUnchanged() throws Exception {
+		alice.update(1, "{\"title\":\"Stable\",\"note\":\"kept\"}").andExpect(status().isOk());
+
+		alice.update(1, "{\"title\":null,\"note\":null}").andExpect(status().isBadRequest());
+		alice.read(1).andExpect(status().isOk()).andExpect(content().json("{\"title\":\"Stable\",\"note\":\"kept\"}", true));
+	}
+
+	@Test
+	void anonymousReadIsUnauthorized() throws Exception {
+		mockMvc.perform(get("/api/documents/1")).andExpect(status().isUnauthorized());
+	}
+
+	@Test
+	void patchWithoutCsrfIsForbiddenAndDocumentStaysUnchanged() throws Exception {
+		alice.update(1, "{\"title\":\"Stable\",\"note\":\"kept\"}").andExpect(status().isOk());
+
+		mockMvc.perform(patch("/api/documents/1")
+						.session(alice.session)
+						.contentType(MediaType.APPLICATION_JSON)
+						.content("{\"title\":\"Hijack\",\"note\":\"nope\"}"))
+				.andExpect(status().isForbidden());
+		alice.read(1).andExpect(status().isOk()).andExpect(content().json("{\"title\":\"Stable\",\"note\":\"kept\"}", true));
+	}
+
+	@Test
+	void anotherEditorsDocumentIsNotFoundAndStaysUnchanged() throws Exception {
+		bob.update(2, "{\"title\":\"Bob draft\",\"note\":\"private\"}").andExpect(status().isOk());
+
+		alice.update(2, "{\"title\":\"Stolen\",\"note\":\"mine\"}").andExpect(status().isNotFound());
+		alice.read(2).andExpect(status().isNotFound());
+		bob.read(2).andExpect(status().isOk()).andExpect(content().json("{\"title\":\"Bob draft\",\"note\":\"private\"}", true));
+		bob.read(1).andExpect(status().isNotFound());
+	}
+
+	@Test
+	void preferencesStayPerEditor() throws Exception {
+		alice.readPreference().andExpect(content().json("{\"theme\":\"light\"}", true));
+		alice.patchPreference("{\"theme\":\"dark\"}")
+				.andExpect(status().isOk())
+				.andExpect(content().json("{\"theme\":\"dark\"}", true));
+		alice.readPreference().andExpect(content().json("{\"theme\":\"dark\"}", true));
+		bob.readPreference().andExpect(content().json("{\"theme\":\"light\"}", true));
+	}
+
+	private void assertSameErrorShape(MvcResult actual, MvcResult existing) throws Exception {
+		assertEquals(existing.getResponse().getContentType(), actual.getResponse().getContentType());
+		assertEquals(existing.getResponse().getContentAsString(), actual.getResponse().getContentAsString());
+		assertEquals(existing.getResponse().getHeaderNames(), actual.getResponse().getHeaderNames());
+	}
+
+	private Editor login(String username) throws Exception {
+		MvcResult csrf = mockMvc.perform(get("/api/csrf")).andExpect(status().isOk()).andReturn();
+		MockHttpSession session = (MockHttpSession) csrf.getRequest().getSession(false);
+		String headerName = JsonPath.read(csrf.getResponse().getContentAsString(), "$.headerName");
+		String token = JsonPath.read(csrf.getResponse().getContentAsString(), "$.token");
+		MvcResult loggedIn = mockMvc.perform(post("/login")
+						.session(session)
+						.header(headerName, token)
+						.param("username", username)
+						.param("password", PASSWORD))
+				.andExpect(status().is3xxRedirection())
+				.andReturn();
+		return new Editor((MockHttpSession) loggedIn.getRequest().getSession(false)).refreshCsrf();
+	}
+
+	private final class Editor {
+		private final MockHttpSession session;
+		private String headerName;
+		private String token;
+
+		private Editor(MockHttpSession session) {
+			this.session = session;
+		}
+
+		private Editor refreshCsrf() throws Exception {
+			MvcResult csrf = mockMvc.perform(get("/api/csrf").session(session)).andExpect(status().isOk()).andReturn();
+			headerName = JsonPath.read(csrf.getResponse().getContentAsString(), "$.headerName");
+			token = JsonPath.read(csrf.getResponse().getContentAsString(), "$.token");
+			return this;
+		}
+
+		private ResultActions read(long id) throws Exception {
+			return mockMvc.perform(get("/api/documents/" + id).session(session));
+		}
+
+		private ResultActions update(long id, String json) throws Exception {
+			return mockMvc.perform(patch("/api/documents/" + id)
+					.session(session)
+					.header(headerName, token)
+					.contentType(MediaType.APPLICATION_JSON)
+					.content(json));
+		}
+
+		private ResultActions readPreference() throws Exception {
+			return mockMvc.perform(get("/api/preferences").session(session)).andExpect(status().isOk());
+		}
+
+		private ResultActions patchPreference(String json) throws Exception {
+			return mockMvc.perform(patch("/api/preferences")
+					.session(session)
+					.header(headerName, token)
+					.contentType(MediaType.APPLICATION_JSON)
+					.content(json));
+		}
+	}
+}

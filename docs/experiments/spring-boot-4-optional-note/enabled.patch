+package com.example.portal;
+
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+
+import tools.jackson.databind.JsonNode;
+import tools.jackson.databind.json.JsonMapper;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.boot.test.web.server.LocalServerPort;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+@SpringBootTest(webEnvironment = WebEnvironment.RANDOM_PORT)
+class DocumentPortalHttpTest {
+
+	private static final JsonMapper JSON = new JsonMapper();
+
+	@LocalServerPort
+	private int port;
+
+	@Test
+	void titleOnlyUpdateMatchesTheExistingDocumentJson() throws Exception {
+		var alice = login("alice");
+		var cleared = alice.patch("/api/documents/1", "{\"title\":\"Alice draft\",\"note\":null}", true);
+		assertOkDocument(cleared, "{\"title\":\"Alice draft\"}");
+
+		var renamed = alice.patch("/api/documents/1", "{\"title\":\"Renamed draft\"}", true);
+		assertOkDocument(renamed, "{\"title\":\"Renamed draft\"}");
+		assertOkDocument(alice.get("/api/documents/1"), "{\"title\":\"Renamed draft\"}");
+
+		var bob = login("bob");
+		var untouched = bob.get("/api/documents/2");
+		assertOkDocument(untouched, "{\"title\":\"Bob draft\"}");
+		var bobRenamed = bob.patch("/api/documents/2", "{\"title\":\"Bob renamed\"}", true);
+		assertOkDocument(bobRenamed, "{\"title\":\"Bob renamed\"}");
+		assertOkDocument(bob.get("/api/documents/2"), "{\"title\":\"Bob renamed\"}");
+	}
+
+	@Test
+	void omittedNoteKeepsStoredNoteIncludingEmptyString() throws Exception {
+		var alice = login("alice");
+		assertOkDocument(alice.patch("/api/documents/1",
+				"{\"title\":\"With note\",\"note\":\"saved note\"}", true),
+				"{\"title\":\"With note\",\"note\":\"saved note\"}");
+
+		var renamed = alice.patch("/api/documents/1", "{\"title\":\"Title only\"}", true);
+		assertOkDocument(renamed, "{\"title\":\"Title only\",\"note\":\"saved note\"}");
+		assertOkDocument(alice.get("/api/documents/1"), "{\"title\":\"Title only\",\"note\":\"saved note\"}");
+
+		assertOkDocument(alice.patch("/api/documents/1", "{\"title\":\"Empty kept\",\"note\":\"\"}", true),
+				"{\"title\":\"Empty kept\",\"note\":\"\"}");
+		assertOkDocument(alice.patch("/api/documents/1", "{\"title\":\"Still empty\"}", true),
+				"{\"title\":\"Still empty\",\"note\":\"\"}");
+		assertOkDocument(alice.get("/api/documents/1"), "{\"title\":\"Still empty\",\"note\":\"\"}");
+	}
+
+	@Test
+	void jsonNullClearsNote() throws Exception {
+		var alice = login("alice");
+		assertOkDocument(alice.patch("/api/documents/1", "{\"title\":\"Noted\",\"note\":\"temporary\"}", true),
+				"{\"title\":\"Noted\",\"note\":\"temporary\"}");
+
+		var cleared = alice.patch("/api/documents/1", "{\"title\":\"Cleared\",\"note\":null}", true);
+		assertOkDocument(cleared, "{\"title\":\"Cleared\"}");
+		assertOkDocument(alice.get("/api/documents/1"), "{\"title\":\"Cleared\"}");
+	}
+
+	@Test
+	void emptyNoteIsStored() throws Exception {
+		var alice = login("alice");
+		var saved = alice.patch("/api/documents/1", "{\"title\":\"Blank note\",\"note\":\"\"}", true);
+		assertOkDocument(saved, "{\"title\":\"Blank note\",\"note\":\"\"}");
+		assertOkDocument(alice.get("/api/documents/1"), "{\"title\":\"Blank note\",\"note\":\"\"}");
+	}
+
+	@Test
+	void noteLengthAllowsFortyCharactersAndRejectsFortyOne() throws Exception {
+		var alice = login("alice");
+		assertOkDocument(alice.patch("/api/documents/1", "{\"title\":\"Plain\",\"note\":null}", true),
+				"{\"title\":\"Plain\"}");
+
+		var rejectedWhileAbsent = alice.patch("/api/documents/1",
+				"{\"title\":\"Should stay plain\",\"note\":\"" + "x".repeat(41) + "\"}", true);
+		assertProblem(rejectedWhileAbsent, 400, "Bad Request", "/api/documents/1");
+		assertOkDocument(alice.get("/api/documents/1"), "{\"title\":\"Plain\"}");
+
+		var note39 = "n".repeat(39);
+		assertOkDocument(alice.patch("/api/documents/1",
+				"{\"title\":\"Thirty nine\",\"note\":\"" + note39 + "\"}", true),
+				"{\"title\":\"Thirty nine\",\"note\":\"" + note39 + "\"}");
+
+		var note40 = "n".repeat(40);
+		assertOkDocument(alice.patch("/api/documents/1",
+				"{\"title\":\"Forty\",\"note\":\"" + note40 + "\"}", true),
+				"{\"title\":\"Forty\",\"note\":\"" + note40 + "\"}");
+		assertOkDocument(alice.get("/api/documents/1"), "{\"title\":\"Forty\",\"note\":\"" + note40 + "\"}");
+
+		var rejected = alice.patch("/api/documents/1",
+				"{\"title\":\"Should stay forty\",\"note\":\"" + "y".repeat(41) + "\"}", true);
+		assertProblem(rejected, 400, "Bad Request", "/api/documents/1");
+		assertOkDocument(alice.get("/api/documents/1"), "{\"title\":\"Forty\",\"note\":\"" + note40 + "\"}");
+	}
+
+	@Test
+	void missingTitleIsRejectedAndDocumentStaysUnchanged() throws Exception {
+		var alice = login("alice");
+		assertOkDocument(alice.patch("/api/documents/1", "{\"title\":\"Before\",\"note\":\"kept\"}", true),
+				"{\"title\":\"Before\",\"note\":\"kept\"}");
+
+		assertProblem(alice.patch("/api/documents/1", "{}", true), 400, "Bad Request", "/api/documents/1");
+		assertOkDocument(alice.get("/api/documents/1"), "{\"title\":\"Before\",\"note\":\"kept\"}");
+
+		assertProblem(alice.patch("/api/documents/1", "{\"note\":\"changed\"}", true),
+				400, "Bad Request", "/api/documents/1");
+		assertOkDocument(alice.get("/api/documents/1"), "{\"title\":\"Before\",\"note\":\"kept\"}");
+
+		assertProblem(alice.patch("/api/documents/1", "{\"title\":null,\"note\":\"changed\"}", true),
+				400, "Bad Request", "/api/documents/1");
+		assertOkDocument(alice.get("/api/documents/1"), "{\"title\":\"Before\",\"note\":\"kept\"}");
+	}
+
+	@Test
+	void sessionLoginCsrfAndPreferencesKeepTheirStatusCodes() throws Exception {
+		var anonymous = new Api(port);
+		var read = anonymous.get("/api/documents/1");
+		assertThat(read.statusCode()).isEqualTo(401);
+		assertThat(read.body()).isEmpty();
+
+		var anonymousWrite = anonymous.patch("/api/documents/1", "{\"title\":\"nope\"}", false);
+		assertProblem(anonymousWrite, 403, "Forbidden", "/api/documents/1");
+
+		var rejectedLogin = new Api(port);
+		rejectedLogin.login("alice", "wrong-password");
+		assertThat(rejectedLogin.loginStatus).isEqualTo(302);
+		assertThat(rejectedLogin.loginLocation).isEqualTo("/login?error");
+		var stillAnonymous = rejectedLogin.get("/api/documents/1");
+		assertThat(stillAnonymous.statusCode()).isEqualTo(401);
+
+		var alice = login("alice");
+		assertThat(alice.loginStatus).isEqualTo(302);
+		assertThat(alice.loginLocation).isEqualTo("/");
+		var beforeBlockedWrite = alice.get("/api/documents/1");
+
+		var withoutCsrf = alice.patch("/api/documents/1", "{\"title\":\"blocked\",\"note\":\"nope\"}", false);
+		assertProblem(withoutCsrf, 403, "Forbidden", "/api/documents/1");
+		assertThat(JSON.readTree(alice.get("/api/documents/1").body()))
+				.isEqualTo(JSON.readTree(beforeBlockedWrite.body()));
+
+		assertOkDocument(alice.get("/api/preferences"), "{\"theme\":\"light\"}");
+		var preferenceWithoutCsrf = alice.patch("/api/preferences", "{\"theme\":\"dark\"}", false);
+		assertProblem(preferenceWithoutCsrf, 403, "Forbidden", "/api/preferences");
+		assertOkDocument(alice.get("/api/preferences"), "{\"theme\":\"light\"}");
+
+		assertOkDocument(alice.patch("/api/preferences", "{\"theme\":\"dark\"}", true), "{\"theme\":\"dark\"}");
+		assertOkDocument(alice.get("/api/preferences"), "{\"theme\":\"dark\"}");
+	}
+
+	@Test
+	void editorCannotReadOrChangeAnotherOwnersDocument() throws Exception {
+		var alice = login("alice");
+		assertOkDocument(alice.patch("/api/documents/1", "{\"title\":\"Alice only\",\"note\":\"private\"}", true),
+				"{\"title\":\"Alice only\",\"note\":\"private\"}");
+
+		var bob = login("bob");
+		assertProblem(bob.get("/api/documents/1"), 404, "Not Found", "/api/documents/1");
+		assertProblem(bob.patch("/api/documents/1", "{\"title\":\"stolen\",\"note\":\"changed\"}", true),
+				404, "Not Found", "/api/documents/1");
+		assertProblem(bob.patch("/api/documents/1", "{}", true), 404, "Not Found", "/api/documents/1");
+		assertProblem(bob.get("/api/documents/99"), 404, "Not Found", "/api/documents/99");
+
+		assertOkDocument(alice.get("/api/documents/1"), "{\"title\":\"Alice only\",\"note\":\"private\"}");
+		assertProblem(alice.get("/api/documents/2"), 404, "Not Found", "/api/documents/2");
+	}
+
+	private Api login(String username) throws Exception {
+		var api = new Api(port);
+		api.login(username, "demo-password");
+		assertThat(api.loginStatus).isEqualTo(302);
+		assertThat(api.loginLocation).isEqualTo("/");
+		return api;
+	}
+
+	private static void assertOkDocument(HttpResponse<String> response, String expectedJson) {
+		assertThat(response.statusCode()).isEqualTo(200);
+		assertThat(response.headers().firstValue("content-type")).hasValueSatisfying(type ->
+				assertThat(type).startsWith("application/json"));
+		assertThat(JSON.readTree(response.body())).isEqualTo(JSON.readTree(expectedJson));
+	}
+
+	private static void assertProblem(HttpResponse<String> response, int status, String error, String path) {
+		assertThat(response.statusCode()).isEqualTo(status);
+		assertThat(response.headers().firstValue("content-type")).hasValueSatisfying(type ->
+				assertThat(type).startsWith("application/json"));
+		JsonNode body = JSON.readTree(response.body());
+		assertThat(body.properties()).extracting(entry -> entry.getKey())
+				.containsExactlyInAnyOrder("timestamp", "status", "error", "path");
+		assertThat(body.get("status").intValue()).isEqualTo(status);
+		assertThat(body.get("error").stringValue()).isEqualTo(error);
+		assertThat(body.get("path").stringValue()).isEqualTo(path);
+	}
+
+	private static final class Api {
+		private final HttpClient http = HttpClient.newBuilder().version(HttpClient.Version.HTTP_1_1).build();
+		private final String base;
+		private final List<String> cookies = new ArrayList<>();
+		private String csrfHeader;
+		private String csrfToken;
+		private int loginStatus;
+		private String loginLocation;
+
+		private Api(int port) {
+			this.base = "http://127.0.0.1:" + port;
+		}
+
+		private void login(String username, String password) throws Exception {
+			var csrf = get("/api/csrf");
+			assertThat(csrf.statusCode()).isEqualTo(200);
+			rememberCsrf(csrf.body());
+			var form = "username=" + username + "&password=" + password;
+			var response = exchange("POST", "/login", form, "application/x-www-form-urlencoded", true);
+			loginStatus = response.statusCode();
+			loginLocation = response.headers().firstValue("location").orElse("");
+			if (loginStatus == 302 && "/".equals(loginLocation)) {
+				rememberCsrf(get("/api/csrf").body());
+			}
+		}
+
+		private HttpResponse<String> get(String path) throws Exception {
+			return exchange("GET", path, null, null, false);
+		}
+
+		private HttpResponse<String> patch(String path, String json, boolean csrf) throws Exception {
+			return exchange("PATCH", path, json, "application/json", csrf);
+		}
+
+		private HttpResponse<String> exchange(String method, String path, String body, String contentType, boolean csrf)
+				throws Exception {
+			var request = HttpRequest.newBuilder(URI.create(base + path))
+					.header("Accept", "application/json");
+			if (!cookies.isEmpty()) {
+				request.header("Cookie", String.join("; ", cookies));
+			}
+			if (csrf) {
+				request.header(csrfHeader, csrfToken);
+			}
+			if (body == null) {
+				request.method(method, HttpRequest.BodyPublishers.noBody());
+			}
+			else {
+				request.header("Content-Type", contentType);
+				request.method(method, HttpRequest.BodyPublishers.ofString(body, StandardCharsets.UTF_8));
+			}
+			var response = http.send(request.build(), HttpResponse.BodyHandlers.ofString(StandardCharsets.UTF_8));
+			storeCookies(response);
+			return response;
+		}
+
+		private void rememberCsrf(String body) {
+			JsonNode csrf = JSON.readTree(body);
+			csrfHeader = csrf.get("headerName").stringValue();
+			csrfToken = csrf.get("token").stringValue();
+		}
+
+		private void storeCookies(HttpResponse<String> response) {
+			for (String header : response.headers().allValues("set-cookie")) {
+				String pair = header.split(";", 2)[0];
+				String name = pair.substring(0, pair.indexOf('='));
+				cookies.removeIf(cookie -> cookie.startsWith(name + "="));
+				cookies.add(pair);
+			}
+		}
+	}
+}

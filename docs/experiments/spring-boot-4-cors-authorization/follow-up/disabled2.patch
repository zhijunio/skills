+	private static CorsConfigurationSource documentRenameCors() {
+		CorsConfiguration configuration = new CorsConfiguration();
+		configuration.setAllowedOrigins(List.of(EDITOR_ORIGIN));
+		configuration.setAllowedMethods(List.of(HttpMethod.PATCH.name()));
+		configuration.setAllowedHeaders(List.of("Content-Type", "X-CSRF-TOKEN"));
+		configuration.setAllowCredentials(true);
+		UrlBasedCorsConfigurationSource source = new UrlBasedCorsConfigurationSource();
+		source.registerCorsConfiguration("/api/documents/{id}", configuration);
+		return source;
+	}
+
+	private static final class DocumentRenameCorsFilter extends OncePerRequestFilter {
+		private final CorsConfigurationSource source;
+		private final CorsProcessor processor = new DefaultCorsProcessor();
+
+		private DocumentRenameCorsFilter(CorsConfigurationSource source) {
+			this.source = source;
+		}
+
+		@Override
+		protected void doFilterInternal(HttpServletRequest request, HttpServletResponse response, FilterChain chain)
+				throws ServletException, IOException {
+			CorsConfiguration configuration = this.source.getCorsConfiguration(request);
+			if (configuration == null || !isCrossOrigin(request)) {
+				chain.doFilter(request, response);
+				return;
+			}
+			boolean preflight = CorsUtils.isPreFlightRequest(request);
+			if (!preflight && !HttpMethod.PATCH.matches(request.getMethod())) {
+				chain.doFilter(request, response);
+				return;
+			}
+			boolean allowed = this.processor.processRequest(configuration, request, response);
+			if (!allowed || preflight) {
+				return;
+			}
+			chain.doFilter(request, response);
+		}
+
+		private static boolean isCrossOrigin(HttpServletRequest request) {
+			try {
+				return CorsUtils.isCorsRequest(request);
+			}
+			catch (IllegalArgumentException ex) {
+				return true;
+			}
+		}
 	}
 }

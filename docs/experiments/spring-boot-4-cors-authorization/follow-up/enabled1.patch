diff -ruN -x target -x *.log -x *.tar.gz base/src/test/java/com/example/portal/DocumentCorsTest.java enabled1/src/test/java/com/example/portal/DocumentCorsTest.java
--- base/src/test/java/com/example/portal/DocumentCorsTest.java	1970-01-01 08:00:00
+++ enabled1/src/test/java/com/example/portal/DocumentCorsTest.java	2026-11-24 09:54:57

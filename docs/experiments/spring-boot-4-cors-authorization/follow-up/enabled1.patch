+package com.example.portal;
+
+import java.net.CookieManager;
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.util.Arrays;
+import java.util.Locale;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.CsvSource;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.web.server.LocalServerPort;
+import tools.jackson.databind.json.JsonMapper;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+@SpringBootTest(webEnvironment = SpringBootTest.WebEnvironment.RANDOM_PORT)
+class DocumentCorsTest {
+	private static final String EDITOR_ORIGIN = "https://editor.example.test";
+	private static final String DOCUMENT = "/api/documents/1";
+	private static final String PREFERENCES = "/api/preferences";
+	private static final String CSRF_HEADER = "X-CSRF-TOKEN";
+	private static final JsonMapper JSON = JsonMapper.builder().build();
+
+	@LocalServerPort
+	private int port;
+
+	@Test
+	void allowsAnonymousPreflightForCredentialedDocumentRename() throws Exception {
+		var response = preflight(EDITOR_ORIGIN, "PATCH", DOCUMENT, "Content-Type, X-CSRF-TOKEN");
+
+		assertThat(response.statusCode()).isBetween(200, 299);
+		assertCredentialedEditorOrigin(response);
+		assertThat(headerValues(response, "Access-Control-Allow-Methods")).containsExactly("patch");
+		assertThat(headerValues(response, "Access-Control-Allow-Headers"))
+				.containsExactlyInAnyOrder("content-type", "x-csrf-token");
+	}
+
+	@ParameterizedTest
+	@CsvSource({
+			"https://other.example.test, PATCH, /api/documents/1, X-CSRF-TOKEN",
+			"https://editor.example.test, GET, /api/documents/1, Content-Type",
+			"https://editor.example.test, POST, /api/documents/1, Content-Type",
+			"https://editor.example.test, PATCH, /api/preferences, X-CSRF-TOKEN",
+			"https://editor.example.test, PATCH, /api/documents/1/history, X-CSRF-TOKEN",
+			"https://editor.example.test, PATCH, /api/documents/1, X-Extra"
+	})
+	void deniesOtherPreflights(String origin, String method, String path, String requestedHeaders)
+			throws Exception {
+		assertThat(preflight(origin, method, path, requestedHeaders)
+				.headers().firstValue("Access-Control-Allow-Origin")).isEmpty();
+	}
+
+	@Test
+	void renamesWithSessionAndCsrfFromEditorOrigin() throws Exception {
+		var client = browser();
+		String csrf = logIn(client, "alice");
+		var response = rename(client, DOCUMENT, EDITOR_ORIGIN, csrf, "Cross-origin rename");
+
+		assertThat(response.statusCode()).isEqualTo(200);
+		assertCredentialedEditorOrigin(response);
+		assertThat(JSON.readTree(response.body()).get("title").asString()).isEqualTo("Cross-origin rename");
+		assertThat(title(client, DOCUMENT)).isEqualTo("Cross-origin rename");
+	}
+
+	@Test
+	void keepsAuthenticationCsrfAndOwnershipChecks() throws Exception {
+		var anonymous = browser();
+		var unauthenticated = rename(anonymous, DOCUMENT, EDITOR_ORIGIN, csrf(anonymous), "Anonymous");
+		assertThat(unauthenticated.statusCode()).isEqualTo(401);
+		assertCredentialedEditorOrigin(unauthenticated);
+
+		var alice = browser();
+		String aliceCsrf = logIn(alice, "alice");
+		String originalTitle = title(alice, DOCUMENT);
+		assertThat(rename(alice, DOCUMENT, EDITOR_ORIGIN, null, "Missing token").statusCode()).isEqualTo(403);
+		assertThat(rename(alice, DOCUMENT, EDITOR_ORIGIN, "invalid", "Invalid token").statusCode()).isEqualTo(403);
+		assertThat(rename(alice, "/api/documents/2", EDITOR_ORIGIN, aliceCsrf, "Wrong owner")
+				.statusCode()).isEqualTo(404);
+		assertThat(title(alice, DOCUMENT)).isEqualTo(originalTitle);
+
+		var bob = browser();
+		logIn(bob, "bob");
+		assertThat(title(bob, "/api/documents/2")).isEqualTo("Bob draft");
+	}
+
+	@Test
+	void deniesActualCrossOriginRequestsOutsideThePolicy() throws Exception {
+		var client = browser();
+		String csrf = logIn(client, "alice");
+		String originalTitle = title(client, DOCUMENT);
+
+		var deniedRename = rename(client, DOCUMENT, "https://other.example.test", csrf, "Unapproved origin");
+		assertThat(deniedRename.headers().firstValue("Access-Control-Allow-Origin")).isEmpty();
+		assertThat(title(client, DOCUMENT)).isEqualTo(originalTitle);
+
+		var deniedRead = send(client, request(DOCUMENT).header("Origin", EDITOR_ORIGIN).GET());
+		assertThat(deniedRead.headers().firstValue("Access-Control-Allow-Origin")).isEmpty();
+		var deniedPreference = send(client, request(PREFERENCES)
+				.header("Origin", EDITOR_ORIGIN)
+				.header(CSRF_HEADER, csrf)
+				.header("Content-Type", "application/json")
+				.method("PATCH", HttpRequest.BodyPublishers.ofString("{\"theme\":\"dark\"}")));
+		assertThat(deniedPreference.headers().firstValue("Access-Control-Allow-Origin")).isEmpty();
+		var preference = send(client, request(PREFERENCES).GET());
+		assertThat(JSON.readTree(preference.body()).get("theme").asString()).isEqualTo("light");
+	}
+
+	@Test
+	void preservesSameOriginRename() throws Exception {
+		var client = browser();
+		String csrf = logIn(client, "alice");
+		var response = rename(client, DOCUMENT, baseUrl(), csrf, "Same-origin rename");
+
+		assertThat(response.statusCode()).isEqualTo(200);
+		assertThat(response.headers().firstValue("Access-Control-Allow-Origin")).isEmpty();
+		assertThat(JSON.readTree(response.body()).get("title").asString()).isEqualTo("Same-origin rename");
+		assertThat(title(client, DOCUMENT)).isEqualTo("Same-origin rename");
+	}
+
+	private HttpResponse<String> preflight(String origin, String method, String path, String requestedHeaders)
+			throws Exception {
+		return send(HttpClient.newHttpClient(), request(path)
+				.header("Origin", origin)
+				.header("Access-Control-Request-Method", method)
+				.header("Access-Control-Request-Headers", requestedHeaders)
+				.method("OPTIONS", HttpRequest.BodyPublishers.noBody()));
+	}
+
+	private HttpResponse<String> rename(HttpClient client, String path, String origin, String csrf, String title)
+			throws Exception {
+		var request = request(path).header("Origin", origin).header("Content-Type", "application/json");
+		if (csrf != null) {
+			request.header(CSRF_HEADER, csrf);
+		}
+		return send(client, request.method("PATCH",
+				HttpRequest.BodyPublishers.ofString(JSON.writeValueAsString(new PortalController.Title(title)))));
+	}
+
+	private HttpClient browser() {
+		return HttpClient.newBuilder().cookieHandler(new CookieManager()).build();
+	}
+
+	private String logIn(HttpClient client, String username) throws Exception {
+		var response = send(client, request("/login").header(CSRF_HEADER, csrf(client))
+				.header("Content-Type", "application/x-www-form-urlencoded")
+				.POST(HttpRequest.BodyPublishers.ofString("username=" + username + "&password=demo-password")));
+		assertThat(response.statusCode()).isEqualTo(302);
+		assertThat(response.headers().firstValue("Location")).hasValue(baseUrl() + "/");
+		return csrf(client);
+	}
+
+	private String csrf(HttpClient client) throws Exception {
+		var response = send(client, request("/api/csrf").GET());
+		assertThat(response.statusCode()).isEqualTo(200);
+		var payload = JSON.readTree(response.body());
+		assertThat(payload.get("headerName").asString()).isEqualTo(CSRF_HEADER);
+		return payload.get("token").asString();
+	}
+
+	private String title(HttpClient client, String path) throws Exception {
+		var response = send(client, request(path).GET());
+		assertThat(response.statusCode()).isEqualTo(200);
+		return JSON.readTree(response.body()).get("title").asString();
+	}
+
+	private HttpRequest.Builder request(String path) {
+		return HttpRequest.newBuilder(URI.create(baseUrl() + path));
+	}
+
+	private String baseUrl() {
+		return "http://localhost:" + port;
+	}
+
+	private static HttpResponse<String> send(HttpClient client, HttpRequest.Builder request) throws Exception {
+		return client.send(request.build(), HttpResponse.BodyHandlers.ofString());
+	}
+
+	private static void assertCredentialedEditorOrigin(HttpResponse<String> response) {
+		assertThat(response.headers().firstValue("Access-Control-Allow-Origin")).hasValue(EDITOR_ORIGIN);
+		assertThat(response.headers().firstValue("Access-Control-Allow-Credentials")).hasValue("true");
+	}
+
+	private static java.util.List<String> headerValues(HttpResponse<String> response, String header) {
+		return response.headers().allValues(header).stream()
+				.flatMap(value -> Arrays.stream(value.split(",")))
+				.map(value -> value.strip().toLowerCase(Locale.ROOT))
+				.toList();
+	}
+}

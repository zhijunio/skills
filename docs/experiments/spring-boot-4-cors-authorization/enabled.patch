diff -ruN -x target base/src/test/java/com/example/portal/DocumentCorsTest.java enabled/src/test/java/com/example/portal/DocumentCorsTest.java
--- base/src/test/java/com/example/portal/DocumentCorsTest.java	1970-01-01 08:00:00
+++ enabled/src/test/java/com/example/portal/DocumentCorsTest.java	2026-11-24 09:50:35
@@ -0,0 +1,186 @@
+package com.example.portal;
+
+import java.net.CookieManager;
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+
+import com.jayway.jsonpath.JsonPath;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.CsvSource;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.web.server.LocalServerPort;
+
+import static java.net.http.HttpRequest.BodyPublishers.noBody;
+import static java.net.http.HttpRequest.BodyPublishers.ofString;
+import static java.net.http.HttpResponse.BodyHandlers.ofString;
+import static org.assertj.core.api.Assertions.assertThat;
+
+@SpringBootTest(webEnvironment = SpringBootTest.WebEnvironment.RANDOM_PORT)
+class DocumentCorsTest {
+
+	private static final String EDITOR = "https://editor.example.test";
+	private static final String OTHER_ORIGIN = "https://other.example.test";
+	private static final String ALICE_DOCUMENT = "/api/documents/1";
+	private static final String BOB_DOCUMENT = "/api/documents/2";
+	private static final String ALLOW_ORIGIN = "Access-Control-Allow-Origin";
+
+	@LocalServerPort
+	private int port;
+
+	@Test
+	void anonymousPreflightAllowsCredentialedRename() throws Exception {
+		var response = preflight(ALICE_DOCUMENT, EDITOR, "PATCH", "content-type, x-csrf-token");
+
+		assertThat(response.statusCode()).isEqualTo(200);
+		assertThat(response.headers().firstValue(ALLOW_ORIGIN)).contains(EDITOR);
+		assertThat(response.headers().firstValue("Access-Control-Allow-Credentials")).contains("true");
+		assertThat(response.headers().firstValue("Access-Control-Allow-Methods")).contains("PATCH");
+		assertThat(response.headers().firstValue("Access-Control-Allow-Headers").orElseThrow().split(",\\s*"))
+				.usingElementComparator(String.CASE_INSENSITIVE_ORDER)
+				.containsExactlyInAnyOrder("Content-Type", "X-CSRF-TOKEN");
+	}
+
+	@ParameterizedTest
+	@CsvSource({
+			"/api/documents/1,  https://other.example.test,  PATCH, 'content-type, x-csrf-token'",
+			"/api/documents/1,  https://editor.example.test, GET,   content-type",
+			"/api/documents/1,  https://editor.example.test, POST,  content-type",
+			"/api/documents/1/subpath, https://editor.example.test, PATCH, content-type",
+			"/api/preferences, https://editor.example.test, PATCH, 'content-type, x-csrf-token'",
+			"/api/csrf,        https://editor.example.test, GET,   content-type"
+	})
+	void preflightGrantsNoAccessOutsideRenamePolicy(String path, String origin, String method, String headers)
+			throws Exception {
+		var response = preflight(path, origin, method, headers);
+
+		assertThat(response.headers().firstValue(ALLOW_ORIGIN)).isEmpty();
+		assertThat(response.headers().firstValue("Access-Control-Allow-Credentials")).isEmpty();
+	}
+
+	@Test
+	void preflightGrantsOnlyTheAllowedRequestHeaders() throws Exception {
+		var response = preflight(ALICE_DOCUMENT, EDITOR, "PATCH", "content-type, x-other");
+
+		assertThat(response.headers().firstValue("Access-Control-Allow-Headers"))
+				.hasValueSatisfying(value -> assertThat(value).isEqualToIgnoringCase("Content-Type"));
+	}
+
+	@Test
+	void crossOriginSessionCanRenameItsOwnDocument() throws Exception {
+		try (var alice = newBrowser()) {
+			var token = signIn(alice, "alice");
+			var response = rename(alice, ALICE_DOCUMENT, EDITOR, token, "Shared draft");
+
+			assertThat(response.statusCode()).isEqualTo(200);
+			assertThat(response.headers().firstValue(ALLOW_ORIGIN)).contains(EDITOR);
+			assertThat(response.headers().firstValue("Access-Control-Allow-Credentials")).contains("true");
+			assertThat(title(response)).isEqualTo("Shared draft");
+			assertThat(readTitle(alice, ALICE_DOCUMENT)).isEqualTo("Shared draft");
+		}
+	}
+
+	@Test
+	void crossOriginRenameStillRequiresLogin() throws Exception {
+		try (var browser = newBrowser()) {
+			var response = rename(browser, ALICE_DOCUMENT, EDITOR, csrfToken(browser), "Anonymous draft");
+
+			assertThat(response.statusCode()).isEqualTo(401);
+			assertThat(response.headers().firstValue(ALLOW_ORIGIN)).contains(EDITOR);
+		}
+	}
+
+	@Test
+	void crossOriginRenameStillRequiresCsrfAndTheCorrectOwner() throws Exception {
+		try (var alice = newBrowser(); var bob = newBrowser()) {
+			var token = signIn(alice, "alice");
+			signIn(bob, "bob");
+			var aliceTitle = readTitle(alice, ALICE_DOCUMENT);
+			var bobTitle = readTitle(bob, BOB_DOCUMENT);
+
+			assertThat(rename(alice, ALICE_DOCUMENT, EDITOR, null, "No token").statusCode()).isEqualTo(403);
+			assertThat(rename(alice, ALICE_DOCUMENT, EDITOR, "invalid", "Invalid token").statusCode()).isEqualTo(403);
+			assertThat(rename(alice, BOB_DOCUMENT, EDITOR, token, "Wrong owner").statusCode()).isEqualTo(404);
+
+			assertThat(readTitle(alice, ALICE_DOCUMENT)).isEqualTo(aliceTitle);
+			assertThat(readTitle(bob, BOB_DOCUMENT)).isEqualTo(bobTitle);
+		}
+	}
+
+	@Test
+	void rejectsAnUnapprovedOriginAndStillAllowsSameOriginRename() throws Exception {
+		try (var alice = newBrowser()) {
+			var token = signIn(alice, "alice");
+			var originalTitle = readTitle(alice, ALICE_DOCUMENT);
+			var denied = rename(alice, ALICE_DOCUMENT, OTHER_ORIGIN, token, "Unapproved origin");
+
+			assertThat(denied.statusCode()).isEqualTo(403);
+			assertThat(denied.headers().firstValue(ALLOW_ORIGIN)).isEmpty();
+			assertThat(readTitle(alice, ALICE_DOCUMENT)).isEqualTo(originalTitle);
+
+			var approved = rename(alice, ALICE_DOCUMENT, "http://localhost:" + port, token, "Same-origin draft");
+			assertThat(approved.statusCode()).isEqualTo(200);
+			assertThat(approved.headers().firstValue(ALLOW_ORIGIN)).isEmpty();
+			assertThat(title(approved)).isEqualTo("Same-origin draft");
+			assertThat(readTitle(alice, ALICE_DOCUMENT)).isEqualTo("Same-origin draft");
+		}
+	}
+
+	private HttpResponse<String> preflight(String path, String origin, String method, String headers) throws Exception {
+		try (var browser = newBrowser()) {
+			return browser.send(request(path)
+					.header("Origin", origin)
+					.header("Access-Control-Request-Method", method)
+					.header("Access-Control-Request-Headers", headers)
+					.method("OPTIONS", noBody()).build(), ofString());
+		}
+	}
+
+	private HttpResponse<String> rename(HttpClient browser, String path, String origin, String token, String title)
+			throws Exception {
+		var patch = request(path).header("Origin", origin).header("Content-Type", "application/json");
+		if (token != null) {
+			patch.header("X-CSRF-TOKEN", token);
+		}
+		return browser.send(patch.method("PATCH", ofString("{\"title\":\"" + title + "\"}")).build(), ofString());
+	}
+
+	private String signIn(HttpClient browser, String user) throws Exception {
+		var token = csrfToken(browser);
+		var login = request("/login")
+				.header("Content-Type", "application/x-www-form-urlencoded")
+				.header("X-CSRF-TOKEN", token)
+				.POST(ofString("username=" + user + "&password=demo-password"));
+		var response = browser.send(login.build(), ofString());
+		assertThat(response.statusCode()).isEqualTo(302);
+		assertThat(response.headers().firstValue("Location")).contains("/");
+		assertThat(response.headers().allValues("Set-Cookie")).anyMatch(cookie -> cookie.startsWith("JSESSIONID="));
+		return csrfToken(browser);
+	}
+
+	private String csrfToken(HttpClient browser) throws Exception {
+		var response = browser.send(request("/api/csrf").GET().build(), ofString());
+		assertThat(response.statusCode()).isEqualTo(200);
+		return JsonPath.read(response.body(), "$.token");
+	}
+
+	private String readTitle(HttpClient browser, String path) throws Exception {
+		var response = browser.send(request(path).GET().build(), ofString());
+		assertThat(response.statusCode()).isEqualTo(200);
+		return title(response);
+	}
+
+	private static String title(HttpResponse<String> response) {
+		return JsonPath.read(response.body(), "$.title");
+	}
+
+	private static HttpClient newBrowser() {
+		return HttpClient.newBuilder().cookieHandler(new CookieManager()).version(HttpClient.Version.HTTP_1_1).build();
+	}
+
+	private HttpRequest.Builder request(String path) {
+		return HttpRequest.newBuilder(URI.create("http://localhost:" + port + path));
+	}
+}

+package com.example.portal;
+
+import com.jayway.jsonpath.JsonPath;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.CsvSource;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc;
+import org.springframework.mock.web.MockHttpSession;
+import org.springframework.test.web.servlet.MockMvc;
+
+import static org.springframework.http.HttpHeaders.ACCESS_CONTROL_ALLOW_CREDENTIALS;
+import static org.springframework.http.HttpHeaders.ACCESS_CONTROL_ALLOW_HEADERS;
+import static org.springframework.http.HttpHeaders.ACCESS_CONTROL_ALLOW_METHODS;
+import static org.springframework.http.HttpHeaders.ACCESS_CONTROL_ALLOW_ORIGIN;
+import static org.springframework.http.HttpHeaders.ACCESS_CONTROL_REQUEST_HEADERS;
+import static org.springframework.http.HttpHeaders.ACCESS_CONTROL_REQUEST_METHOD;
+import static org.springframework.http.HttpHeaders.ORIGIN;
+import static org.springframework.http.MediaType.APPLICATION_JSON;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.options;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.patch;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.header;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+@SpringBootTest
+@AutoConfigureMockMvc
+class PortalCorsTests {
+
+	private static final String EDITOR_ORIGIN = "https://editor.example.test";
+	private static final String DOCUMENT = "/api/documents/1";
+	private static final String CSRF_HEADER = "X-CSRF-TOKEN";
+	private static final String RENAME = """
+			{"title":"Browser edit"}
+			""";
+
+	@Autowired
+	private MockMvc mvc;
+
+	@Test
+	void preflightAllowsCredentialedRenameWithoutASession() throws Exception {
+		mvc.perform(options(DOCUMENT)
+				.header(ORIGIN, EDITOR_ORIGIN)
+				.header(ACCESS_CONTROL_REQUEST_METHOD, "PATCH")
+				.header(ACCESS_CONTROL_REQUEST_HEADERS, "Content-Type, X-CSRF-TOKEN"))
+				.andExpect(status().isOk())
+				.andExpect(header().string(ACCESS_CONTROL_ALLOW_ORIGIN, EDITOR_ORIGIN))
+				.andExpect(header().string(ACCESS_CONTROL_ALLOW_METHODS, "PATCH"))
+				.andExpect(header().string(ACCESS_CONTROL_ALLOW_HEADERS, "Content-Type, X-CSRF-TOKEN"))
+				.andExpect(header().string(ACCESS_CONTROL_ALLOW_CREDENTIALS, "true"));
+	}
+
+	@ParameterizedTest
+	@CsvSource({
+			"https://other.example.test, /api/documents/1, PATCH, Content-Type",
+			"http://editor.example.test, /api/documents/1, PATCH, Content-Type",
+			"https://editor.example.test, /api/documents/1, GET, X-CSRF-TOKEN",
+			"https://editor.example.test, /api/documents/1, PUT, Content-Type",
+			"https://editor.example.test, /api/documents/1, PATCH, Authorization",
+			"https://editor.example.test, /api/documents/1/extra, PATCH, Content-Type",
+			"https://editor.example.test, /api/preferences, PATCH, Content-Type",
+			"https://editor.example.test, /api/csrf, GET, X-CSRF-TOKEN"
+	})
+	void otherPreflightsReceiveNoCorsPermission(String origin, String path, String method, String requestHeader)
+			throws Exception {
+		mvc.perform(options(path)
+				.header(ORIGIN, origin)
+				.header(ACCESS_CONTROL_REQUEST_METHOD, method)
+				.header(ACCESS_CONTROL_REQUEST_HEADERS, requestHeader))
+				.andExpect(header().doesNotExist(ACCESS_CONTROL_ALLOW_ORIGIN))
+				.andExpect(header().doesNotExist(ACCESS_CONTROL_ALLOW_METHODS))
+				.andExpect(header().doesNotExist(ACCESS_CONTROL_ALLOW_HEADERS))
+				.andExpect(header().doesNotExist(ACCESS_CONTROL_ALLOW_CREDENTIALS));
+	}
+
+	@Test
+	void browserRenameUsesTheLoggedInSessionAndReturnsTheNewTitle() throws Exception {
+		var alice = login("alice");
+		mvc.perform(patch(DOCUMENT).session(alice.session())
+				.header(ORIGIN, EDITOR_ORIGIN).header(CSRF_HEADER, alice.token())
+				.contentType(APPLICATION_JSON).content(RENAME))
+				.andExpect(status().isOk())
+				.andExpect(header().string(ACCESS_CONTROL_ALLOW_ORIGIN, EDITOR_ORIGIN))
+				.andExpect(header().string(ACCESS_CONTROL_ALLOW_CREDENTIALS, "true"))
+				.andExpect(content().json(RENAME));
+
+		mvc.perform(get(DOCUMENT).session(alice.session()))
+				.andExpect(status().isOk())
+				.andExpect(content().json(RENAME));
+	}
+
+	@Test
+	void approvedOriginStillRequiresLogin() throws Exception {
+		var anonymous = csrf(new MockHttpSession());
+		mvc.perform(patch(DOCUMENT).session(anonymous.session())
+				.header(ORIGIN, EDITOR_ORIGIN).header(CSRF_HEADER, anonymous.token())
+				.contentType(APPLICATION_JSON).content(RENAME))
+				.andExpect(status().isUnauthorized());
+	}
+
+	@Test
+	void approvedOriginStillRequiresCsrfAndDocumentOwnership() throws Exception {
+		var alice = login("alice");
+		mvc.perform(patch(DOCUMENT).session(alice.session())
+				.header(ORIGIN, EDITOR_ORIGIN)
+				.contentType(APPLICATION_JSON).content(RENAME))
+				.andExpect(status().isForbidden());
+
+		mvc.perform(patch("/api/documents/2").session(alice.session())
+				.header(ORIGIN, EDITOR_ORIGIN).header(CSRF_HEADER, alice.token())
+				.contentType(APPLICATION_JSON).content(RENAME))
+				.andExpect(status().isNotFound());
+	}
+
+	@Test
+	void unapprovedOriginCannotRenameWithAValidSessionAndCsrfToken() throws Exception {
+		var alice = login("alice");
+		mvc.perform(patch(DOCUMENT).session(alice.session())
+				.header(ORIGIN, "https://other.example.test").header(CSRF_HEADER, alice.token())
+				.contentType(APPLICATION_JSON).content(RENAME))
+				.andExpect(status().isForbidden())
+				.andExpect(header().doesNotExist(ACCESS_CONTROL_ALLOW_ORIGIN));
+	}
+
+	@Test
+	void documentGetWithAnOriginKeepsSameOriginAccessOnly() throws Exception {
+		var alice = login("alice");
+		mvc.perform(get(DOCUMENT).session(alice.session()).header(ORIGIN, "http://localhost"))
+				.andExpect(status().isOk())
+				.andExpect(header().doesNotExist(ACCESS_CONTROL_ALLOW_ORIGIN));
+
+		mvc.perform(get(DOCUMENT).session(alice.session()).header(ORIGIN, EDITOR_ORIGIN))
+				.andExpect(status().isForbidden())
+				.andExpect(header().doesNotExist(ACCESS_CONTROL_ALLOW_ORIGIN));
+	}
+
+	@Test
+	void sameOriginPatchesStillWork() throws Exception {
+		var alice = login("alice");
+		mvc.perform(patch(DOCUMENT).session(alice.session())
+				.header(ORIGIN, "http://localhost").header(CSRF_HEADER, alice.token())
+				.contentType(APPLICATION_JSON).content(RENAME))
+				.andExpect(status().isOk())
+				.andExpect(header().doesNotExist(ACCESS_CONTROL_ALLOW_ORIGIN))
+				.andExpect(content().json(RENAME));
+
+		var theme = """
+				{"theme":"dark"}
+				""";
+		mvc.perform(patch("/api/preferences").session(alice.session())
+				.header(ORIGIN, "http://localhost").header(CSRF_HEADER, alice.token())
+				.contentType(APPLICATION_JSON).content(theme))
+				.andExpect(status().isOk())
+				.andExpect(header().doesNotExist(ACCESS_CONTROL_ALLOW_ORIGIN))
+				.andExpect(content().json(theme));
+	}
+
+	private SessionCsrf login(String username) throws Exception {
+		var anonymous = csrf(new MockHttpSession());
+		var login = mvc.perform(post("/login").session(anonymous.session())
+				.param("username", username).param("password", "demo-password")
+				.param("_csrf", anonymous.token()))
+				.andExpect(status().is3xxRedirection())
+				.andReturn();
+		return csrf((MockHttpSession) login.getRequest().getSession(false));
+	}
+
+	private SessionCsrf csrf(MockHttpSession session) throws Exception {
+		var result = mvc.perform(get("/api/csrf").session(session))
+				.andExpect(status().isOk())
+				.andReturn();
+		String token = JsonPath.read(result.getResponse().getContentAsString(), "$.token");
+		return new SessionCsrf(session, token);
+	}
+
+	private record SessionCsrf(MockHttpSession session, String token) {}
+}

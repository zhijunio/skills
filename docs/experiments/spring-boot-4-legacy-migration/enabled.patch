--- base/src/main/resources/db/migration/V2__add_order_source.sql	1970-01-01 08:00:00
+++ enabled/src/main/resources/db/migration/V2__add_order_source.sql	2026-11-24 09:39:41
@@ -0,0 +1,9 @@
+ALTER TABLE orders ADD COLUMN order_source varchar(5);
+
+UPDATE orders
+SET order_source = CASE
+    WHEN left(order_number, 4) COLLATE "C" = 'WEB-' THEN 'WEB'
+    ELSE 'OTHER'
+END;
+
+ALTER TABLE orders ALTER COLUMN order_source SET NOT NULL;
